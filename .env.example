# ─────────────────────────────────────────────────────────────────────────────
# Microgrid IEMS — deployment configuration.
# Copy this file to .env at the repo root before `docker compose up`.
# Everything in this file is read by docker-compose.yaml at startup.
# ─────────────────────────────────────────────────────────────────────────────

# ── AnyLog license & object storage ─────────────────────────────────────────
# Request these from the AnyLog team. Without ANYLOG_LICENSE the operator
# and master nodes will refuse to start.
ANYLOG_LICENSE=
AKAVE_ACCESS_KEY_RC2=
AKAVE_SECRET_KEY_RC2=
AKAVE_ENDPOINT_RC2=

# ── eGauge meter (LAN device at the install site) ───────────────────────────
# The producer container polls this device once per second and publishes
# readings to Kafka. Credentials come from the eGauge admin UI.
EGAUGE_URI=https://your-egauge-id.egaug.es
EGAUGE_USER=
EGAUGE_PASS=

# ── Postgres ────────────────────────────────────────────────────────────────
# These match what the AnyLog operator expects in
# streaming/anylog/docker-makefiles/operator1-configs/base_configs.env
# (DB_USER=demo, DB_PASSWD=change-me). Change them in both places if you want
# different credentials.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=customers

# ── House / site location ───────────────────────────────────────────────────
# Used by the weather fetcher (Open-Meteo, no API key required) for
# irradiance, cloud cover, and outside temperature. Default = Los Gatos, CA.
HOUSE_LAT=37.24
HOUSE_LON=-121.96
HOUSE_TZ=America/Los_Angeles

# ── Inference loop ──────────────────────────────────────────────────────────
# How often the NILM disaggregator wakes up (seconds). 30s is the default
# matching the dev laptop's launchd agent.
INFERENCE_TICK_SECONDS=30

# ── Solar Assistant MQTT broker (LAN device at the install site) ─────────────
# Feeds the solar-producer service which streams into the solar_data table.
# Credentials come from the Solar Assistant Configuration > MQTT page.
SA_BROKER=192.168.1.48
SA_PORT=1883
SA_USER=microgrid
SA_PASS=
SA_PREFIX=solar_assistant

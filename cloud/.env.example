# cloud/.env  (gitignored). Fill every placeholder.

# This VM's Tailscale address. Every port binds here and nowhere else.
TAILNET_IP=100.x.y.z
# The Pi's Tailscale address
PI_TAILNET_IP=100.a.b.c

# AnyLog
ANYLOG_IMAGE=anylogco/anylog-network:VERSION
ANYLOG_LICENSE_KEY=CHANGE_ME
ANYLOG_COMPANY=CHANGE_ME

# Postgres for the archive operator
POSTGRES_USER=iems
POSTGRES_PASSWORD=CHANGE_ME

# AnyLog remote GUI overlay with the IEMS plugin
IEMS_GUI_IMAGE=iems-remote-gui:VERSION

# Hosted language model for Ask and the MCP client
LLM_API_TYPE=CHANGE_ME
LLM_ENDPOINT=https://CHANGE_ME
LLM_API_KEY=CHANGE_ME
LLM_MODEL=CHANGE_ME

# /etc/iems/edgelake.env  (mode 0600, owner root)
# EdgeLake edge operator on the Pi. Variable names keep their ANYLOG_ prefix because
# EdgeLake's deployment scripts read them that way. Values with spaces are quoted so
# the file works both as a systemd EnvironmentFile and when sourced by a shell.
# Settings that differ from EdgeLake's defaults are explained in docs/06.

# --- Paths -----------------------------------------------------------------------
EDGELAKE_PATH=/srv/iems/edgelake
ANYLOG_PATH=/srv/iems/edgelake
EDGELAKE_HOME=/srv/iems/edgelake/EdgeLake
LOCAL_SCRIPTS=/opt/iems/edgelake/deployment-scripts
TEST_DIR=/opt/iems/edgelake/deployment-scripts/tests
PYTHONPATH=/opt/iems/edgelake/EdgeLake

# --- Identity ----------------------------------------------------------------------
NODE_TYPE=operator
NODE_NAME=iems-edge-operator
COMPANY_NAME=IEMS
CLUSTER_NAME=iems-edge-cluster
DEFAULT_DBMS=customers

# --- Network -----------------------------------------------------------------------
ANYLOG_SERVER_PORT=32148
ANYLOG_REST_PORT=32149
ANYLOG_BROKER_PORT=1883
# Cloud master over the tailnet
LEDGER_CONN=CLOUD_MASTER_TAILNET_ADDRESS:32048
# This Pi's Tailscale address, advertised in the ledger instead of 127.0.0.1
OVERLAY_IP=PI_TAILNET_ADDRESS
TCP_BIND=false
REST_BIND=false
BROKER_BIND=false
TCP_THREADS=2
REST_THREADS=2
BROKER_THREADS=2
REST_TIMEOUT=30
BLOCKCHAIN_SOURCE=master
BLOCKCHAIN_SYNC="60 seconds"

# --- Storage -----------------------------------------------------------------------
DB_TYPE=sqlite
SYSTEM_QUERY=true
MEMORY=true
ENABLE_PARTITIONS=true
PARTITION_COLUMN=insert_timestamp
PARTITION_INTERVAL="1 day"
PARTITION_KEEP=3
PARTITION_SYNC="1 day"

# --- Ingest ------------------------------------------------------------------------
OPERATOR_THREADS=1
WRITE_IMMEDIATE=true
THRESHOLD_TIME="30 seconds"
THRESHOLD_VOLUME=100KB
ARCHIVE=false
ARCHIVE_DELETE=2
COMPRESS_FILE=true

# --- Features not used on the Pi ---------------------------------------------------
ENABLE_MCP=false
ENABLE_MQTT=false
ENABLE_OPCUA=false
ENABLE_VIDEO_STREAMING=false
ENABLE_HA=false
BLOBS_STORAGE=false
NODE_MONITORING=false
STORE_MONITORING=false
SYSLOG_MONITORING=false
DOCKER_MONITORING=false
DISABLE_CLI=true

# The eGauge and solar message clients are registered from this script on every start.
DEPLOY_LOCAL_SCRIPT=true

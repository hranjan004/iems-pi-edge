# /etc/iems/edge.env  (mode 0600, owner root)
# Copy this file and fill in the placeholders. Never commit the filled copy.

# --- eGauge meter -----------------------------------------------------------
# Prefer the LAN address of the meter over the cloud relay.
EGAUGE_URI=http://EGAUGE_LAN_ADDRESS
EGAUGE_USER=owner
EGAUGE_PASS=CHANGE_ME
EGAUGE_DEV_ID=egauge-site
POLL_INTERVAL=1
EGAUGE_TOPIC=egauge

# --- Solar Assistant ----------------------------------------------------------
SA_BROKER=SOLAR_ASSISTANT_LAN_ADDRESS
SA_PORT=1883
SA_USER=
SA_PASS=
SA_PREFIX=solar_assistant
INGEST_MODE=broker
ANYLOG_TOPIC=solar

# --- Local AnyLog operator ----------------------------------------------------
ANYLOG_HOST=127.0.0.1
ANYLOG_PORT=32149
ANYLOG_REST_PORT=32149
ANYLOG_BROKER=127.0.0.1
ANYLOG_BROKER_PORT=1883
ANYLOG_DBMS=customers
ANYLOG_USER_AGENT=AnyLog/1.23
ANYLOG_HOME=/srv/iems/anylog
# Tailscale address of the cloud master, used by the operator to join the network
LEDGER_CONN=CLOUD_MASTER_TAILNET_ADDRESS:32048
# This node's Tailscale address, advertised in the ledger instead of 127.0.0.1
OVERLAY_IP=PI_TAILNET_ADDRESS

# --- IEMS backend and inference ----------------------------------------------
PYTHONPATH=/opt/iems/microgrid-manager/services:/opt/iems/microgrid-manager/services/iems/backend
IEMS_MODELS_DIR=/srv/iems/models/current
INFERENCE_TICK_SECONDS=30
HOUSE_LAT=0.0
HOUSE_LON=0.0
HOUSE_TZ=America/Los_Angeles

# --- Dashboard ---------------------------------------------------------------
IEMS_HOST=127.0.0.1
IEMS_PORT=8009
HA_URL=http://HOME_ASSISTANT_LAN_ADDRESS:8123
HA_TOKEN_FILE=/etc/iems/ha_token

# --- Producer spool and heartbeats ---------------------------------------------
SPOOL_PATH=/srv/iems/buffer/egauge.spool
SPOOL_MAX_BYTES=268435456
HEARTBEAT_PATH=/run/iems/egauge.heartbeat

# --- Model registry -------------------------------------------------------------
MODEL_REGISTRY_URL=https://REGISTRY_HOST/iems-models
MODEL_REGISTRY_TOKEN=

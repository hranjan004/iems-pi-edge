services:
  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    ports:
      - "11434:11434"
    volumes:
      - ollama-data:/root/.ollama
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: unless-stopped
    # No GPU block — macOS host has no NVIDIA GPU

  iems-app:
    build:
      context: ./services/remote-gui
    container_name: iems-app
    ports:
      - "8000:8000"   # FastAPI backend
      - "3001:3001"   # React frontend (served by serve)
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - ANYLOG_REST_URL=http://host.docker.internal:32149
      - ANYLOG_HOST=host.docker.internal
      - ANYLOG_REST_PORT=32149
      - ANYLOG_USER_AGENT=AnyLog/1.23
      - OLLAMA_URL=http://host.docker.internal:11434
      - PYTHONPATH=/app:/app/services
      - HOUSE_LAT=37.24
      - HOUSE_LON=-121.96
      - HOUSE_TZ=America/Los_Angeles
      - REACT_APP_API_URL=http://localhost:8000
      - PGHOST=host.docker.internal
      - PGPORT=5432
      - PGDATABASE=customers
      - PGUSER=demo
      - PGPASSWORD=change-me
    volumes:
      # IEMS service code volume-mounted so rebuilds aren't needed for Python changes
      - ./services/iems:/app/services/iems:ro
    depends_on:
      - ollama
    restart: unless-stopped

volumes:
  ollama-data:

# ── GX10 stack configuration ────────────────────────────────────────────────
# cp gx10/.env.example gx10/.env   (gx10/.env is gitignored)

# AnyLog. The license is the same one Pat's box uses; copy it from the .env on
# Pat's box (ANYLOG_LICENSE=...). The nodes refuse to start without it.
ANYLOG_LICENSE=
ANYLOG_IMAGE=anylogco/anylog-network:local-nuitka-arm

# Postgres (the AnyLog operator connects as demo/change-me; see streaming/postgres/init)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=customers

# Site (Pat's house). Drives tod/sun features, so keep it the source site.
HOUSE_LAT=37.24
HOUSE_LON=-121.96
HOUSE_TZ=America/Los_Angeles
INFERENCE_TICK_SECONDS=30

# Replay producer
REPLAY_SPEED=1          # 1 = real time, 10 = ten source seconds per wall second
REPLAY_ALIGN=tod        # tod = start at the same local time of day as now

# NILM engine: bilstm, or nemotron once the fine-tuned model is served
# (gx10/scripts/serve_nemotron_nilm.sh). The BiLSTM stays as the fallback.
NILM_ENGINE=bilstm
NEMOTRON_URL=http://host.docker.internal:8011/v1
NEMOTRON_MODEL=nilm

# Local LLM, Ollama API. Default: Nemotron 3.5 Lightning in Ollama on the host.
#   host Ollama:        LLM_URL=http://host.docker.internal:11434
#   --profile ollama:   same URL (the container publishes :11434)
#   --profile bridge:   same URL (the bridge publishes :11434), and set NIM_URL
LLM_URL=http://host.docker.internal:11434
LLM_MODEL=nemotron-3.5-lightning
NIM_URL=http://host.docker.internal:8010/v1
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Only for --profile live (GX10 on Pat's LAN with the real meter)
EGAUGE_URI=https://your-egauge-id.egaug.es
EGAUGE_USER=
EGAUGE_PASS=

# Optional Akave archival storage, referenced by the AnyLog configs. Blank is fine.
AKAVE_ACCESS_KEY_RC2=
AKAVE_SECRET_KEY_RC2=
AKAVE_ENDPOINT_RC2=

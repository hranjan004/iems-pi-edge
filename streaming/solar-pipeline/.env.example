# Solar Assistant MQTT broker (LAN device at the install site).
# Credentials come from the Solar Assistant Configuration > MQTT page.
SA_BROKER=192.168.1.48
SA_PORT=1883
SA_USER=microgrid
SA_PASS=
SA_PREFIX=solar_assistant
# Ingestion path: broker (publish to AnyLog MQTT broker) or rest (streaming PUT)
INGEST_MODE=broker
ANYLOG_BROKER=host.docker.internal
ANYLOG_BROKER_PORT=1883
ANYLOG_TOPIC=solar

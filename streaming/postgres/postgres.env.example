# Postgres credentials for AnyLog operator.
# Copy this file to postgres.env at deploy time.
# The AnyLog operator's DB_USER/DB_PASSWD in operator1-configs/base_configs.env
# must match POSTGRES_USER/POSTGRES_PASSWORD here.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=customers
POSTGRES_INITDB_ARGS=--auth=md5
